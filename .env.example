# Supabase project settings (Dashboard → Project Settings → API).
# Both values are public by design: data is protected by the Row Level Security policies in supabase/schema.sql.
# Local dev: copy this file to .env.local. Vercel: add both under Project → Settings → Environment Variables.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY"
