{
  "name": "daf-leitner-box",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && oxlint --deny-warnings",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "e2e": "playwright test",
    "test:sql:isolated": "node scripts/test-sql-wasm.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "db:questions:check": "node scripts/build-adjective-bank.mjs --check",
    "db:upgrade:check": "node scripts/check-schema-upgrade.mjs",
    "check:edge": "npx --yes deno@2.9.6 check --node-modules-dir=none --lock=supabase/functions/send-reminders/deno.lock --frozen-lockfile supabase/functions/send-reminders/index.ts",
    "test:edge": "ECE_KEYLOG=0 npx --yes deno@2.9.6 test --node-modules-dir=none --lock=supabase/functions/send-reminders/deno.lock --frozen-lockfile --allow-env=ECE_KEYLOG,NODE_DEBUG,DEBUG supabase/functions/send-reminders/pushRuntime.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.93.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
