    {
      "id": "g-01-01-regelmaessige-verben-im-praesens",
      "block": 1,
      "lesson": 1,
      "level": "A1",
      "title": "Regelmäßige Verben im Präsens",
      "rule": "Ein Verb besteht aus dem Stamm und einer Endung. Die Endung zeigt die Person an: ich -e, du -st, er/sie/es -t, wir -en, ihr -t, sie/Sie -en.\nEndet der Stamm auf -t oder -d (arbeiten, finden), steht bei du, er/sie/es und ihr ein zusätzliches -e: du arbeitest, er arbeitet.",
      "examples": [
        "s01q2n0080"
      ],
      "table": {
        "head": [
          "",
          "lernen",
          "arbeiten",
          "tanzen"
        ],
        "rows": [
          [
            "ich",
            "lerne",
            "arbeite",
            "tanze"
          ],
          [
            "du",
            "lernst",
            "arbeitest",
            "tanzt"
          ],
          [
            "er / sie / es",
            "lernt",
            "arbeitet",
            "tanzt"
          ],
          [
            "wir",
            "lernen",
            "arbeiten",
            "tanzen"
          ],
          [
            "ihr",
            "lernt",
            "arbeitet",
            "tanzt"
          ],
          [
            "sie / Sie",
            "lernen",
            "arbeiten",
            "tanzen"
          ]
        ]
      },
      "related": [
        "g-01-02-personalpronomen-im-nominativ-und-akkusativ"
      ]
    },
    {
      "id": "g-01-01-wortstellung-in-aussagen-w-fragen-und-ja-nein-fragen",
      "block": 1,
      "lesson": 1,
      "level": "A1",
      "title": "Wortstellung in Aussagen, W-Fragen und Ja/Nein-Fragen",
      "rule": "In einer Aussage und in einer W-Frage steht das konjugierte Verb auf Position 2. W-Fragen beginnen mit einem Fragewort (wer, was, wo, woher, wann, wie).\nIn einer Ja/Nein-Frage steht das konjugierte Verb auf Position 1. Man antwortet mit Ja oder Nein.",
      "examples": [
        "s01q6n0304"
      ],
      "table": {
        "head": [
          "",
          "Position 1",
          "Position 2",
          "Rest"
        ],
        "rows": [
          [
            "Aussage",
            "Tim",
            "wohnt",
            "in Hamburg."
          ],
          [
            "W-Frage",
            "Wo",
            "wohnt",
            "Tim?"
          ],
          [
            "Ja/Nein-Frage",
            "Wohnt",
            "Tim",
            "in Hamburg?"
          ]
        ]
      }
    },
    {
      "id": "g-01-02-verneinung-mit-nicht-und-kein",
      "block": 1,
      "lesson": 2,
      "level": "A1",
      "title": "Verneinung mit „nicht“ und „kein“",
      "rule": "Mit „kein-“ verneinst du ein Nomen, vor dem ein unbestimmter Artikel stehen würde oder gar kein Artikel steht: Ich habe keine Zeit.\nMit „nicht“ verneinst du alles andere: ein Verb, einen ganzen Satz, ein Adjektiv oder eine Zeitangabe. Oft steht „nicht“ am Satzende oder direkt vor dem Wort, das verneint wird: Er kommt nicht. Das ist nicht teuer.",
      "examples": [
        "s01q3n0174",
        "s01q5n0233"
      ],
      "related": [
        "g-01-02-nominativ-und-akkusativ-mit-unbestimmtem-artikel-und-negativ"
      ]
    },
    {
      "id": "g-01-02-artikel-bestimmt-und-unbestimmt",
      "block": 1,
      "lesson": 2,
      "level": "A1",
      "title": "Artikel: bestimmt und unbestimmt",
      "rule": "Ist eine Sache neu in dem Gespräch oder Text, steht der unbestimmte Artikel (ein, eine). Ist sie schon bekannt, steht der bestimmte Artikel (der, das, die).\nDer Artikel zeigt das Genus des Nomens: maskulin, neutral oder feminin. Im Plural gibt es nur „die“; der unbestimmte Artikel fehlt.",
      "examples": [
        "s01q1n0002",
        "s01q4n0177"
      ],
      "table": {
        "head": [
          "",
          "maskulin",
          "neutral",
          "feminin",
          "Plural"
        ],
        "rows": [
          [
            "bestimmt",
            "der Tisch",
            "das Buch",
            "die Lampe",
            "die Stühle"
          ],
          [
            "unbestimmt",
            "ein Tisch",
            "ein Buch",
            "eine Lampe",
            "– Stühle"
          ]
        ]
      }
    },
    {
      "id": "g-01-02-wortstellung-subjekt",
      "block": 1,
      "lesson": 2,
      "level": "A1",
      "title": "Wortstellung: Subjekt",
      "rule": "Das Verb steht in der Aussage immer auf Position 2. Auf Position 1 steht oft das Subjekt, aber es kann auch eine Zeit- oder Ortsangabe stehen. Dann folgt das Subjekt direkt nach dem Verb.",
      "examples": [
        "s01q1n0009",
        "s01q4n0179"
      ],
      "table": {
        "head": [
          "Position 1",
          "Position 2",
          "Rest"
        ],
        "rows": [
          [
            "Wir",
            "essen",
            "heute Abend Pizza."
          ],
          [
            "Heute Abend",
            "essen",
            "wir Pizza."
          ]
        ]
      }
    },
    {
      "id": "g-01-02-nominativ-und-akkusativ-mit-bestimmtem-artikel",
      "block": 1,
      "lesson": 2,
      "level": "A1",
      "title": "Nominativ und Akkusativ mit bestimmtem Artikel",
      "rule": "Das Subjekt steht im Nominativ. Das direkte Objekt, zum Beispiel nach haben, sehen, kaufen oder brauchen, steht im Akkusativ.\nMit dem bestimmten Artikel ändert sich nur das Maskulinum: aus „der“ wird „den“. Neutrum, Femininum und Plural bleiben gleich.",
      "examples": [
        "s01q4n0186",
        "s01q5n0285"
      ],
      "table": {
        "head": [
          "",
          "maskulin",
          "neutral",
          "feminin",
          "Plural"
        ],
        "rows": [
          [
            "Nominativ",
            "der Hund",
            "das Pferd",
            "die Katze",
            "die Fische"
          ],
          [
            "Akkusativ",
            "den Hund",
            "das Pferd",
            "die Katze",
            "die Fische"
          ]
        ]
      },
      "related": [
        "g-01-02-artikel-bestimmt-und-unbestimmt"
      ]
    },
    {
      "id": "g-01-02-nominativ-und-akkusativ-mit-unbestimmtem-artikel-und-negativ",
      "block": 1,
      "lesson": 2,
      "level": "A1",
      "title": "Nominativ und Akkusativ mit unbestimmtem Artikel und Negativartikel",
      "rule": "Auch beim unbestimmten Artikel und bei „kein-“ ändert sich im Akkusativ nur das Maskulinum: „ein“ wird „einen“, „kein“ wird „keinen“. Die anderen Formen bleiben gleich.\nIm Plural steht kein unbestimmter Artikel, die Verneinung heißt „keine“.",
      "examples": [
        "s01q4n0178",
        "s01q1n0003"
      ],
      "table": {
        "head": [
          "",
          "maskulin",
          "neutral",
          "feminin",
          "Plural"
        ],
        "rows": [
          [
            "Nominativ",
            "ein / kein Hund",
            "ein / kein Pferd",
            "eine / keine Katze",
            "– / keine Fische"
          ],
          [
            "Akkusativ",
            "einen / keinen Hund",
            "ein / kein Pferd",
            "eine / keine Katze",
            "– / keine Fische"
          ]
        ]
      },
      "related": [
        "g-01-02-verneinung-mit-nicht-und-kein"
      ]
    },
    {
      "id": "g-01-02-personalpronomen-im-nominativ-und-akkusativ",
      "block": 1,
      "lesson": 2,
      "level": "A1",
      "title": "Personalpronomen im Nominativ und Akkusativ",
      "rule": "Personalpronomen ersetzen Personen und Dinge. Im Akkusativ ändern sich ich, du, er, wir und ihr: mich, dich, ihn, uns, euch. Die Formen sie, es und Sie bleiben gleich.",
