    {
      "id": "g-01-03-verbindung-von-satzteilen-mit-und",
      "block": 1,
      "lesson": 3,
      "level": "A1",
      "title": "Verbindung von Satzteilen mit „und“",
      "rule": "Mit „und“ verbindest du Wörter, Wortgruppen und Sätze. Gehören beide Teile zusammen, steht vor „und“ kein Komma: Tim und Anna kochen. Ich kaufe Brot und Käse.",
      "examples": [
        "s01q2n0052",
        "s01q1n0004"
      ]
    },
    {
      "id": "g-01-03-wortstellung-in-saetzen-mit-und",
      "block": 1,
      "lesson": 3,
      "level": "A1",
      "title": "Wortstellung in Sätzen mit „und“",
      "rule": "„Und“ steht auf Position 0, es ist kein Satzglied und verändert die Wortstellung nicht. Nach „und“ beginnt ein neuer Hauptsatz: Das Verb steht wieder auf Position 2. Ist das Subjekt gleich, kann man es im zweiten Satz weglassen.",
      "examples": [
        "s01q1n0037",
        "s01q4n0217"
      ],
