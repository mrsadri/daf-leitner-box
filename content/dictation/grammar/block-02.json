    {
      "id": "g-02-04-perfekt-regelmaessige-verben",
      "block": 2,
      "lesson": 4,
      "level": "A1",
      "title": "Perfekt: regelmäßige Verben",
      "rule": "Das Perfekt bildet man mit „haben“ oder „sein“ auf Position 2 und dem Partizip II am Satzende. Bei regelmäßigen Verben heißt das Partizip II ge- + Stamm + -t (gespielt, gekocht). Verben auf -ieren und viele Verben mit Vorsilbe haben kein „ge-“ (trainiert, besucht).\nMeistens steht „haben“. „Sein“ steht bei Verben der Bewegung und der Veränderung (gestartet, passiert).",
      "examples": [
        "s02q2n0154",
        "s02q6n0357"
      ],
      "table": {
        "head": [
          "Position 1",
          "Position 2",
          "Mitte",
          "Satzende"
        ],
        "rows": [
          [
            "Wir",
            "haben",
            "gestern lange",
            "gespielt."
          ],
          [
            "Er",
            "hat",
            "das Essen",
            "gekocht."
          ],
          [
            "Sie",
            "hat",
            "viel",
            "trainiert."
          ]
        ]
      },
      "related": [
        "g-02-05-perfekt-unregelmaessige-verben-und-gemischte-verben"
      ]
    },
    {
      "id": "g-02-04-konnektoren-denn-grund-oder-alternative-aber-gegensatz",
      "block": 2,
      "lesson": 4,
      "level": "A1",
      "title": "Konnektoren: „denn“ (Grund), „oder“ (Alternative), „aber“ (Gegensatz)",
      "rule": "„Denn“ nennt einen Grund, „oder“ eine Alternative und „aber“ einen Gegensatz. Alle drei stehen auf Position 0 zwischen zwei Hauptsätzen. Die Wortstellung im zweiten Satz ändert sich nicht: Das Verb steht auf Position 2.\nVor „denn“ und „aber“ steht ein Komma, vor „oder“ in der Regel nicht.",
      "examples": [
        "s02q1n0014",
        "s02q6n0414"
      ],
      "table": {
        "head": [
          "Hauptsatz 1",
          "Position 0",
          "Hauptsatz 2"
        ],
        "rows": [
          [
            "Ich bleibe heute zu Hause,",
            "denn",
            "ich bin müde."
          ],
          [
            "Wir gehen ins Kino",
            "oder",
            "wir bleiben zu Hause."
          ],
          [
            "Er ist nett,",
            "aber",
            "er hat nie Zeit."
          ]
        ]
      }
    },
